\! curl -s -o /dev/null -w "%{http_code}" http://localhost:9187/notfound > /tmp/pwh_test_notfound.txt
\set notfound_code `tr -d '[:space:]' < /tmp/pwh_test_notfound.txt`
SELECT :'notfound_code' = '404' AS invalid_path_returns_404;
